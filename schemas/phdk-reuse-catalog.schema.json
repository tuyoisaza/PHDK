{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tuyoisaza/PHDK/schemas/phdk-reuse-catalog.schema.json",
  "title": "PHDK Reuse Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "source"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "specification",
        "capabilities",
        "implementation",
        "downloadable",
        "dependencies",
        "compatibility",
        "security",
        "license",
        "evidence",
        "maintenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "SPECIFICATION_ONLY",
            "CANDIDATE",
            "REVIEWED",
            "ACCEPTED_VERSIONED",
            "DEPRECATED"
          ]
        },
        "specification": {
          "$ref": "#/$defs/text"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "implementation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/implementation"
            }
          ]
        },
        "downloadable": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimes",
            "frameworks",
            "contracts"
          ],
          "properties": {
            "runtimes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "frameworks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "SPECIFICATION_ONLY",
                "PENDING",
                "REVIEWED",
                "FAILED"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/versionEvidence"
              }
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "identifier",
            "evidence",
            "rights"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_APPLICABLE",
                "PENDING",
                "VERIFIED",
                "REJECTED"
              ]
            },
            "identifier": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/versionEvidence"
              }
            },
            "rights": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tests_present",
            "test_status",
            "portability_consumers",
            "notes",
            "test_runs"
          ],
          "properties": {
            "tests_present": {
              "type": "boolean"
            },
            "test_status": {
              "enum": [
                "NOT_RUN",
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "portability_consumers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/consumerEvidence"
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "test_runs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/versionEvidence"
              }
            }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "policy"
          ],
          "properties": {
            "owner": {
              "$ref": "#/$defs/text"
            },
            "policy": {
              "$ref": "#/$defs/text"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SPECIFICATION_ONLY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "type": "null"
              },
              "downloadable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CANDIDATE",
                  "REVIEWED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "$ref": "#/$defs/implementation"
              },
              "downloadable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ACCEPTED_VERSIONED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "allOf": [
                  {
                    "$ref": "#/$defs/implementation"
                  },
                  {
                    "properties": {
                      "version": {
                        "$ref": "#/$defs/resolvedText"
                      }
                    }
                  }
                ]
              },
              "downloadable": {
                "const": true
              },
              "security": {
                "properties": {
                  "status": {
                    "const": "REVIEWED"
                  },
                  "evidence": {
                    "minItems": 1
                  }
                }
              },
              "license": {
                "properties": {
                  "status": {
                    "const": "VERIFIED"
                  },
                  "evidence": {
                    "minItems": 1
                  },
                  "identifier": {
                    "$ref": "#/$defs/text"
                  },
                  "rights": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              "evidence": {
                "properties": {
                  "tests_present": {
                    "const": true
                  },
                  "test_status": {
                    "const": "PASS"
                  },
                  "portability_consumers": {
                    "minItems": 2
                  },
                  "test_runs": {
                    "minItems": 1
                  }
                }
              },
              "maintenance": {
                "properties": {
                  "owner": {
                    "$ref": "#/$defs/resolvedText"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "resolvedText": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "^\\s*UNASSIGNED\\s*$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "versionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "references"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/resolvedText"
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      },
      "description": "References for exactly implementation.version; equality is enforced by the stdlib checker."
    },
    "consumerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "version",
        "references"
      ],
      "properties": {
        "consumer": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/resolvedText"
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      },
      "description": "Evidence for this consumer at exactly implementation.version; consumer identity uniqueness and version equality are enforced by the stdlib checker."
    }
  },
  "$comment": "Structural contract. Also run the stdlib checker for equal implementation/evidence versions and unique entry/consumer identities. References are metadata, not proof."
}
