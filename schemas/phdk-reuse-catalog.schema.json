{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tuyoisaza/PHDK/schemas/phdk-reuse-catalog.schema.json",
  "title": "PHDK Reuse Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "source"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "specification",
        "capabilities",
        "implementation",
        "downloadable",
        "dependencies",
        "compatibility",
        "security",
        "license",
        "evidence",
        "maintenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SPECIFICATION_ONLY",
            "CANDIDATE",
            "REVIEWED",
            "ACCEPTED_VERSIONED",
            "DEPRECATED"
          ]
        },
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/implementation"
            }
          ]
        },
        "downloadable": {
          "type": "boolean"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtimes",
            "frameworks",
            "contracts"
          ],
          "properties": {
            "runtimes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contracts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "SPECIFICATION_ONLY",
                "PENDING",
                "REVIEWED",
                "FAILED"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "identifier",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_APPLICABLE",
                "PENDING",
                "VERIFIED",
                "REJECTED"
              ]
            },
            "identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tests_present",
            "test_status",
            "portability_consumers",
            "notes"
          ],
          "properties": {
            "tests_present": {
              "type": "boolean"
            },
            "test_status": {
              "enum": [
                "NOT_RUN",
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "portability_consumers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "policy"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "policy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SPECIFICATION_ONLY"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "type": "null"
              },
              "downloadable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "CANDIDATE",
                  "REVIEWED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "$ref": "#/$defs/implementation"
              },
              "downloadable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ACCEPTED_VERSIONED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "implementation": {
                "$ref": "#/$defs/implementation"
              },
              "downloadable": {
                "const": true
              },
              "security": {
                "properties": {
                  "status": {
                    "const": "REVIEWED"
                  }
                }
              },
              "license": {
                "properties": {
                  "status": {
                    "const": "VERIFIED"
                  }
                }
              },
              "evidence": {
                "properties": {
                  "tests_present": {
                    "const": true
                  },
                  "test_status": {
                    "const": "PASS"
                  },
                  "portability_consumers": {
                    "minItems": 2
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
